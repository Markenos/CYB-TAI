# From my.akahu.nz -> Developers -> your Personal App
AKAHU_APP_TOKEN=app_token_xxxxxxxxxxxxxxxxxxxxxxxxx
AKAHU_USER_TOKEN=user_token_xxxxxxxxxxxxxxxxxxxxxxxxx

# Money movement is OFF unless you set this to true (and enable payments in Akahu)
AKAHU_ENABLE_PAYMENTS=false
# Hard cap per payment or transfer, in NZD
AKAHU_MAX_PAYMENT_NZD=500
# Optional: only allow payments to these NZ account numbers (comma separated)
# AKAHU_ALLOWED_PAYEES=12-3456-7890123-00,01-0123-0456789-000
